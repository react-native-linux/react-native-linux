{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "unicorn", "import", "promise", "jsx-a11y", "node", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    "eslint/capitalized-comments": [
      "error",
      "always",
      {
        "ignorePattern": "v8 ignore"
      }
    ],
    "eslint/new-cap": [
      "error",
      {
        "capIsNewExceptions": ["PlatformColor"]
      }
    ],
    "eslint/no-ternary": "off",
    "eslint/one-var": ["error", "never"],
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true
      }
    ],
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/prefer-default-export": "off",
    "node/no-sync": "off",
    "node/no-top-level-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "react/forbid-component-props": "off",
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "arrow-function"
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "unicorn/no-null": "off"
  },
  "overrides": [
    {
      "files": ["*.config.ts", "**/*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["packages/core/src-linux/**"],
      "rules": {
        "import/no-default-export": "off",
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["packages/*/src/index.ts"],
      "rules": {
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": ["packages/core/goldens/fixtures.ts"],
      "rules": {
        "eslint/max-lines": "off"
      }
    },
    {
      "files": ["commitlint.config.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "import/unambiguous": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/test-bundles",
    "build",
    "coverage",
    "packages/*/upstream",
    "packages/cli/test-fixtures/cpp-library",
    "third_party"
  ]
}
