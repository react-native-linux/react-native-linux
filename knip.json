{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.ts", "scripts/**/*.ts"],
      "ignoreBinaries": ["cmake", "ctest", "readelf"],
      "ignoreDependencies": ["react-native-worklets"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["desktop-file-validate"]
    },
    "packages/core": {
      "entry": ["goldens/*.spec.ts", "scripts/*.ts", "src-linux/**/*.linux.ts"],
      "project": ["goldens/**/*.ts", "scripts/**/*.ts", "src-linux/**/*.ts"],
      "ignoreBinaries": ["cmake"]
    },
    "packages/test-harness": {
      "entry": ["index.ts", "scripts/*.ts"],
      "project": ["src/**/*.tsx", "scripts/**/*.ts"],
      "ignoreDependencies": ["@babel/runtime", "@react-native/babel-preset"]
    }
  }
}
