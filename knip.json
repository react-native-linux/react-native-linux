{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/codegen-spec.ts"],
      "project": ["*.ts", "scripts/**/*.ts"],
      "ignoreBinaries": ["cmake", "ctest", "ldd", "readelf"],
      "ignoreDependencies": ["react-native-worklets"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["desktop-file-validate"]
    },
    "packages/core": {
      "entry": ["goldens/*.spec.ts", "scripts/*.ts", "src-linux/**/*.linux.ts"],
      "project": ["goldens/**/*.ts", "scripts/**/*.ts", "src-linux/**/*.ts"],
      "ignoreBinaries": ["cmake"]
    },
    "packages/test-harness": {
      "entry": ["index.ts", "scripts/*.ts"],
      "project": ["src/**/*.tsx", "scripts/**/*.ts"],
      "ignoreDependencies": [
        "@babel/runtime",
        "@react-native-linux/enriched-markdown",
        "@react-native-linux/gesture-handler",
        "@react-native-linux/reanimated",
        "deep-equal",
        "flow-enums-runtime",
        "jest-diff",
        "metro-symbolicate",
        "nullthrows",
        "pretty-format",
        "tinybench"
      ]
    },
    "packages/expo": {
      "project": ["src/**/*.ts"],
      "expo": false,
      "ignoreDependencies": [
        "expo-application",
        "expo-asset",
        "expo-device",
        "expo-file-system",
        "expo-font",
        "expo-linking",
        "expo-modules-core",
        "expo-network",
        "whatwg-url-minimum"
      ]
    },
    "packages/gesture-handler": {
      "project": ["src/**/*.ts"],
      "ignore": ["upstream/**"],
      "ignoreDependencies": ["invariant"]
    },
    "packages/reanimated": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["react-native-is-edge-to-edge"]
    }
  }
}
