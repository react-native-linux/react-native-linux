{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "scripts/vendor-react-native.ts", "scripts/vendor-skia.ts"],
      "project": ["*.ts", "scripts/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/platform-config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["goldens/*.spec.ts"],
      "project": ["goldens/**/*.ts"],
      "ignoreBinaries": ["cmake"]
    }
  }
}
