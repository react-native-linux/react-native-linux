{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.ts", "scripts/**/*.ts"],
      "ignoreBinaries": ["cmake", "ctest"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["goldens/*.spec.ts", "scripts/*.ts"],
      "project": ["goldens/**/*.ts", "scripts/**/*.ts", "src-linux/**/*.ts"],
      "ignoreBinaries": ["cmake"]
    }
  }
}
