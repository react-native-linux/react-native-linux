{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "expo-modules-core/src/polyfill/dangerous-internal": [
        "./packages/core/types/expo-modules-core-dangerous-internal.d.ts"
      ]
    },
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/enriched-markdown/src/**/*.tsx",
    "packages/test-harness/modules/*/*.spec.ts",
    "packages/core/goldens/*.ts",
    "packages/core/scripts/**/*.ts",
    "packages/core/src-linux/**/*.ts",
    "packages/core/index.ts",
    "scripts/autolink.ts",
    "scripts/codegen-spec.ts",
    "scripts/codegen-core/**/*.ts",
    "scripts/codegen-core.ts",
    "scripts/create-package/**/*.ts",
    "scripts/create-package.ts",
    "scripts/doctor/**/*.ts",
    "scripts/doctor.ts",
    "scripts/e2e/**/*.ts",
    "scripts/e2e.ts",
    "scripts/format-cpp/**/*.ts",
    "scripts/format-cpp.ts",
    "scripts/fresh-project.ts",
    "scripts/headless-compositor.ts",
    "scripts/pack-local/**/*.ts",
    "scripts/pack-local.ts",
    "scripts/prop-coverage/**/*.ts",
    "scripts/prop-coverage.ts",
    "scripts/upstream/**/*.ts",
    "scripts/upstream.ts",
    "vitest.config.ts"
  ]
}
