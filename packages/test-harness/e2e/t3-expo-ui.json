{
  "name": "t3-expo-ui",
  "bundle": "t3-expo-ui.tsx",
  "ready": "t3-expo-ui: ready",
  "frames": 1200,
  "windowFlags": ["--no-decorations"],
  "steps": [
    "sleep 1500",
    "move 600 600",
    "sleep 300",
    "move 168 114",
    "button left press",
    "sleep 50",
    "move 210 114",
    "sleep 50",
    "move 257 114",
    "sleep 50",
    "button left release",
    "await t3-expo-ui: light slider value=20",
    "click 128 184",
    "await t3-expo-ui: light number value=8",
    "click 464 184",
    "await t3-expo-ui: dark number value=6",
    "click 200 282",
    "click 48 352",
    "sleep 500"
  ],
  "expect": [
    "t3-expo-ui: light slider value=20",
    "t3-expo-ui: light number value=8",
    "t3-expo-ui: dark number value=6"
  ],
  "reject": ["t3-expo-ui: light disabled slider changed", "t3-expo-ui: light number at its minimum changed"],
  "screenshot": {
    "golden": "t3-expo-ui.png",
    "crop": {
      "left": 0,
      "top": 0,
      "width": 848,
      "height": 400
    },
    "maxDifferentPixels": 1
  }
}
