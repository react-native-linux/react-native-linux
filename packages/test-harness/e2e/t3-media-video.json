{
  "name": "t3-media-video",
  "bundle": "t3-media-video.tsx",
  "ready": "t3-media-video: ready",
  "frames": 600,
  "windowFlags": ["--no-decorations"],
  "steps": [
    "sleep 500",
    "click 848 106",
    "click 176 106",
    "await t3-media-video: open https://example.com/demo.mp4",
    "click 512 106",
    "await t3-media-video: open https://assets.example.com/signed-recording.webm?signature=renewed",
    "sleep 300"
  ],
  "expect": [
    "t3-media-video: demo playback start",
    "t3-media-video: open https://example.com/demo.mp4",
    "t3-media-video: open https://assets.example.com/signed-recording.webm?signature=renewed"
  ],
  "reject": [
    "t3-media-video: missing playback start",
    "t3-media-video: open https://example.com/missing.mp4",
    "signature=expired"
  ],
  "screenshot": {
    "golden": "t3-media-video.png",
    "crop": {
      "left": 0,
      "top": 0,
      "width": 1024,
      "height": 212
    },
    "maxDifferentPixels": 1
  }
}
