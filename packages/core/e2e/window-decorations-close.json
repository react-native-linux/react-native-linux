{
  "name": "window-decorations-close",
  "bundle": "fabric-view.js",
  "ready": "fabric-view: committed surface 1",
  "frames": 600,
  "windowFlags": ["--force-client-decorations", "--app-id", "org.reactnative.linux.e2e"],
  "allowErrors": true,
  "steps": ["sleep 500", "click 1250 16", "sleep 500"],
  "expect": [
    "[rnl-decorations] mode=client app-id=org.reactnative.linux.e2e",
    "[rnl-decorations] close",
    "the window closed before frame 600 could be captured"
  ]
}
