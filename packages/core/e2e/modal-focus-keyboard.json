{
  "name": "modal-focus-keyboard",
  "bundle": "modal-focus.tsx",
  "ready": "modal-focus: committed",
  "frames": 900,
  "steps": [
    "sleep 500",
    "click 100 28",
    "sleep 150",
    "type hi",
    "await modal-focus: draft hi",
    "key Tab press",
    "key Tab release",
    "await modal-focus: focus open",
    "key space press",
    "key space release",
    "await modal-focus: show",
    "key Tab press",
    "key Tab release",
    "sleep 150",
    "key Tab press",
    "key Tab release",
    "sleep 150",
    "key Shift_L press",
    "key Tab press",
    "key Tab release",
    "key Shift_L release",
    "sleep 150",
    "key Escape press",
    "key Escape release",
    "await modal-focus: request close",
    "sleep 300",
    "key Shift_L press",
    "key Tab press",
    "key Tab release",
    "key Shift_L release",
    "sleep 150",
    "type !",
    "sleep 400"
  ],
  "expect": [
    "modal-focus: draft hi",
    "modal-focus: focus open",
    "modal-focus: blur open",
    "modal-focus: focus first",
    "modal-focus: show",
    "modal-focus: focus second",
    "modal-focus: focus first",
    "modal-focus: focus second",
    "modal-focus: request close",
    "modal-focus: focus open",
    "modal-focus: blur open",
    "modal-focus: draft hi!"
  ],
  "reject": ["modal-focus: back", "modal-focus: page scroll"]
}
