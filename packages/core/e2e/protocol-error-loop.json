{
  "name": "protocol-error-loop",
  "bundle": "hello.js",
  "ready": "[rnl-decorations] mode=bare",
  "frames": 900,
  "windowFlags": ["--no-decorations", "--inject-protocol-error-after-frame"],
  "allowErrors": true,
  "expectsExitAfter": "wayland protocol error: xdg_wm_base#7",
  "steps": ["sleep 500"],
  "expect": ["[rnl-window] wayland protocol error: xdg_wm_base#"],
  "reject": ["Broken pipe"]
}
