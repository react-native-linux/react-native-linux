{
  "name": "protocol-error-loop",
  "bundle": "hello.js",
  "ready": "react-native-linux: bundle evaluated",
  "frames": 900,
  "windowFlags": ["--no-decorations", "--inject-protocol-error-after-frame"],
  "allowErrors": true,
  "steps": ["sleep 500"],
  "expect": ["[rnl-window] wayland protocol error: xdg_wm_base#"],
  "reject": ["Broken pipe"]
}
