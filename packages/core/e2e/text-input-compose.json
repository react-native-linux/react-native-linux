{
  "name": "text-input-compose",
  "bundle": "text-input-compose.js",
  "ready": "text-input-compose: committed surface 1",
  "frames": 600,
  "windowFlags": [
    "--no-decorations",
    "--inject-key-sequence",
    "{Tab}{Preedit:ni}{Tab}{Preedit:ha}{Commit:好}{Preedit:ya}{Commit:o}"
