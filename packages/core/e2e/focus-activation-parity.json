    "click 260 120",
    "sleep 150",
    "click 700 120",
    "sleep 150",
    "click 860 120",
    "sleep 150",
    "key Tab press",
    "key Tab release",
    "sleep 150",
    "key Return press",
    "key Return release",
    "sleep 150",
    "key Tab press",
    "key Tab release",
    "sleep 150",
    "key space press",
    "key space release",
    "sleep 150",
    "key Tab press",
    "key Tab release",
    "sleep 150",
    "key Return press",
    "key Return release",
    "sleep 150",
    "key Tab press",
    "key Tab release",
