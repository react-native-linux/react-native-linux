    "focus: topClick on alpha clicks=5",
    "focus: topBlur on alpha",
    "focus: topFocus on beta",
    "focus: topKeyDown on beta key=  code=Space clicks=5",
    "focus: topClick on beta clicks=6",
    "focus: topBlur on beta",
    "focus: topFocus on epsilon",
    "focus: topKeyDown on epsilon key=Enter code=Enter clicks=6",
    "focus: topClick on epsilon clicks=7",
    "focus: topBlur on epsilon",
    "focus: topFocus on zeta",
    "focus: topKeyDown on zeta key=Enter code=Enter clicks=7",
    "focus: topClick on zeta clicks=8"
