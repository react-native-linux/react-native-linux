{
  "name": "alert-before-mount",
  "bundle": "alert.tsx",
  "ready": "alert: committed",
  "frames": 600,
  "steps": ["sleep 800", "key Escape press", "key Escape release", "await alert: press early ok", "sleep 300"],
  "expect": ["alert: committed", "alert: press early ok"],
  "reject": ["Invariant Violation", "alert: launch"]
}
