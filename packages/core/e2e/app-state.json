{
  "name": "app-state",
  "bundle": "app-state.js",
  "ready": "app-state: committed surface 1",
  "frames": 240,
  "occludedFallback": true,
  "windowFlags": [
    "--no-decorations",
    "--inject-window-sequence",
    "{Activated}{Activated}{Activated}{Deactivated}{Suspended}{Resumed}{Activated}"
  ],
  "steps": ["sleep 2000"],
  "expect": [
    "app-state: initial active",
    "app-state: committed surface 1",
    "activated=0 suspended=0",
    "app-state: focus false",
    "activated=0 suspended=1",
    "app-state: change 1 background",
    "activated=0 suspended=0",
    "app-state: change 2 active",
    "activated=1 suspended=0",
    "app-state: focus true"
  ],
  "reject": ["app-state: change 3", "inactive"]
}
