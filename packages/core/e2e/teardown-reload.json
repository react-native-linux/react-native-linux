{
  "name": "teardown-reload",
  "bundle": "teardown-reload.js",
  "ready": "teardown: instance 1 committed",
  "frames": 900,
  "steps": ["sleep 100"],
  "steadyAcrossReloads": true,
  "windowFlags": ["--no-decorations", "--inject-key-sequence", "{Tab}{Preedit:ni}"],
  "expect": [
    "[rnl-ime] field focused",
    "teardown: composing \"ni\"",
    "[rnl-teardown]",
    "teardown: instance 2 committed",
    "[rnl-teardown]",
    "teardown: instance 3 committed",
    "[rnl-teardown]",
    "teardown: instance 4 committed"
  ]
}
