{
  "name": "@react-native-linux/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "assets:test-animation": "node scripts/make-test-animation.ts",
    "assets:test-image": "node scripts/make-test-image.ts",
    "build": "cmake --build ../../build/dev",
    "configure": "cmake -S ../.. --preset dev",
    "override:validate": "react-native-platform-override validate",
    "run:animated-scroll": "../../build/dev/bin/hello_react --animated-scroll test-bundles/animated-scroll.js 160 100 3",
    "run:fabric": "../../build/dev/bin/hello_react --fabric test-bundles/fabric-view.js",
    "run:golden": "../../build/dev/bin/hello_react --golden test-bundles/fabric-view.js /tmp/rnl-fabric-view.png",
    "run:golden:damage": "../../build/dev/bin/hello_react --damage-golden test-bundles/damage.js /tmp/rnl-damage.png",
    "run:golden:focus": "../../build/dev/bin/hello_react --focus-tab test-bundles/focus.js /tmp/rnl-focus.png 3",
    "run:golden:image": "../../build/dev/bin/hello_react --golden test-bundles/image.js /tmp/rnl-image.png",
    "run:golden:image:animated": "../../build/dev/bin/hello_react --animated-image test-bundles/animated-image.js /tmp/rnl-animated-image.png 20",
    "run:golden:scroll": "../../build/dev/bin/hello_react --scroll-to test-bundles/scroll.js /tmp/rnl-scroll.png 160 100 3",
    "run:golden:text": "../../build/dev/bin/hello_react --golden test-bundles/text.js /tmp/rnl-text.png",
    "run:golden:text-input": "../../build/dev/bin/hello_react --type test-bundles/text-input.js /tmp/rnl-text-input.png \"Hello{Left}{Left}X\"",
    "run:golden:text-input:selection": "../../build/dev/bin/hello_react --type test-bundles/text-input.js /tmp/rnl-text-input-selection.png \"Hello world{Ctrl+A}\"",
    "run:hello": "../../build/dev/bin/hello_react",
    "run:input": "../../build/dev/bin/hello_react --inject-pointer test-bundles/pressable.js 200 140",
    "run:window": "../../build/dev/bin/rnl_window",
    "run:window:fabric": "../../build/dev/bin/rnl_window --fabric test-bundles/fabric-view.js",
    "run:window:ime": "../../build/dev/bin/rnl_window --ime-debug",
    "vendor": "node ../../scripts/vendor-react-native.ts",
    "vendor:fonts": "node ../../scripts/vendor-fonts.ts",
    "vendor:skia": "node ../../scripts/vendor-skia.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "pngjs": "catalog:",
    "react-native-platform-override": "catalog:",
    "vitest": "catalog:"
  }
}
